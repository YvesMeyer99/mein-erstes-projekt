# Bitcoin: comma-separated label:address pairs
BITCOIN_ADDRESSES=main:bc1qexampleaddress

# Ethereum: comma-separated label:address pairs
ETHEREUM_ADDRESSES=main:0xExampleAddress
ETHERSCAN_API_KEY=your-etherscan-api-key

# Kraken: read-only API key (no trade/withdraw permission!)
KRAKEN_API_KEY=your-read-only-kraken-key
KRAKEN_API_SECRET=your-read-only-kraken-secret

# Coinbase (App/Retail API): CDP Secret API Key with an ECDSA (P-256) key type.
# Grant ONLY the read-only scopes: wallet:accounts:read, wallet:transactions:read
# (no trade/send/withdraw permissions!). The private key is multi-line PEM -
# write it here with literal \n instead of real line breaks.
COINBASE_API_KEY_NAME=organizations/your-org-id/apiKeys/your-key-id
COINBASE_API_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END EC PRIVATE KEY-----\n

# MEXC: read-only API key/secret. Deposits/withdrawals sync automatically.
# Trades require manually listing which pairs to track (MEXC has no
# "all trades" endpoint - symbol is mandatory per call), format
# SYMBOL:BASE:QUOTE, comma-separated.
MEXC_API_KEY=your-read-only-mexc-key
MEXC_API_SECRET=your-read-only-mexc-secret
MEXC_TRADING_PAIRS=BTCUSDT:BTC:USDT,ETHUSDT:ETH:USDT

# Binance: read-only API key/secret. Deposits/withdrawals sync
# automatically (internally paginated in 90-day windows - a Binance API
# limit, transparent to you). Trades require manually listing which pairs
# to track (Binance has no "all trades" endpoint - symbol is mandatory
# per call), format SYMBOL:BASE:QUOTE, comma-separated. Unlike MEXC,
# Binance's trade history has no 30-day limit - the full history is
# always retrievable.
BINANCE_API_KEY=your-read-only-binance-key
BINANCE_API_SECRET=your-read-only-binance-secret
BINANCE_TRADING_PAIRS=BTCUSDT:BTC:USDT,ETHUSDT:ETH:USDT
# Optional: seeds the very first deposit/withdrawal sync's start date
# (e.g. your Binance account creation date, YYYY-MM-DD). Binance has no
# "give me everything" mode for deposits/withdrawals - without this,
# the first sync falls back to covering the last 5 years.
BINANCE_SYNC_START=2020-01-01

# Optional, defaults to a local SQLite file
DATABASE_URL=sqlite:///./krypto_dashboard.db
